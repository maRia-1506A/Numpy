     "text": [
      "Reshaped array:  [[0 1]\n",
      " [2 3]\n",
      " [4 5]\n",
      " [6 7]]\n"
     ]
    }
   ],
   "source": [
    "arr1= np.arange(8)\n",
    "reshape= arr1.reshape((4,2))\n",
    "print(\"Reshaped array: \", reshape)\n",
    "\n",
    "# trnaspose\n",
    "transpose= reshape.transpose()\n",
    "print(\"Transpose array: \", transpose)"
   ]
  }
